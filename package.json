    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "dotenv": "^18.0.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
